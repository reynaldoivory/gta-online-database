{
  "name": "gta-online-database",
  "version": "1.0.0",
  "private": true,
  "description": "GTA Online Vehicle Equivalencies Database",
  "scripts": {
    "dev": "cd GTA-Vehicle-Database-App && npm run dev",
    "build": "cd GTA-Vehicle-Database-App && npm run build",
    "preview": "cd GTA-Vehicle-Database-App && npm run preview",
    "install:app": "cd GTA-Vehicle-Database-App && npm install",
    "lint": "cd GTA-Vehicle-Database-App && npm run lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "data/*.csv": [
      "echo 'CSV file changed - validating...'"
    ]
  },
  "keywords": [
    "gta",
    "vehicle",
    "database"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
